# Copy to .env.local for local development (never commit .env.local).
# Same keys get set in Netlify Site settings -> Environment variables for deploys.

# Supabase project settings -> API Keys -> Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project settings -> API Keys -> Secret key.
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_. Used only by
# lib/supabase/admin.ts (signed document URLs).
SUPABASE_SECRET_KEY=

# The email domain allowed to sign in (app-level check in
# app/(auth)/auth/callback/route.ts, alongside the single-tenant Entra ID
# app registration which is the IdP-level restriction).
ALLOWED_EMAIL_DOMAIN=kidzink.com

# The site's own URL, used to build the OAuth redirect. Use your Netlify
# URL in production; localhost for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Supabase CLI (`supabase start`) also needs these for the Azure
# provider block in supabase/config.toml:
# SUPABASE_AUTH_EXTERNAL_AZURE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_AZURE_SECRET=
# SUPABASE_AUTH_EXTERNAL_AZURE_URL=https://login.microsoftonline.com/<tenant-id>/v2.0

# Email/password sign-in (see lib/actions/dev-auth.ts) is always available
# locally. Set this to "true" in Netlify to temporarily also allow it on
# the deployed site, e.g. so someone without a KidzInk Microsoft 365
# account (a designer reviewing the UI) can sign up and sign in. Unset it
# (or set to anything else) once that's no longer needed — Microsoft SSO
# is the only sanctioned login for real use.
# ENABLE_EMAIL_LOGIN=true

# --- Netlify BUILD-time only — do NOT copy these to your local .env.local ---
# @kidzink/ui (github:adnankidzinkdesign-cell/kidzink-ui) is a private repo.
# npm bakes a git+ssh:// URL into package-lock.json's resolved field for it
# regardless of the protocol package.json declares, and Netlify's automatic
# npm ci step runs before any preinstall script or build.command could
# rewrite that — so nothing at the project level can intercept it in time.
# The fix: these 4 vars, read natively by git itself (unconditionally, on
# every invocation) via its GIT_CONFIG_COUNT/KEY_n/VALUE_n env-var support,
# rewriting both the ssh:// URL npm tries and plain https:// as a fallback
# to an authenticated form. Local dev doesn't need any of this — your own
# machine already has working GitHub auth via gh/credential manager.
#
# PAT: a fine-grained GitHub PAT created from the REPO OWNER's account
# (adnankidzinkdesign-cell), not a collaborator account — collaborator-
# created tokens have hit ambiguous 403s here even with the right scope.
# Repository access: only kidzink-ui. Repository permissions: Contents =
# Read-only (Metadata: Read-only gets auto-added alongside it — expected).
#
# Mark GIT_CONFIG_KEY_0 and GIT_CONFIG_KEY_1 as "contains secret values" in
# Netlify — they embed the raw token. Rotate the PAT by regenerating it on
# GitHub and pasting the new value into both KEY_0 and KEY_1 below.
#
# GIT_CONFIG_COUNT=2
# GIT_CONFIG_KEY_0=url.https://<PAT>@github.com/.insteadOf
# GIT_CONFIG_VALUE_0=ssh://git@github.com/
# GIT_CONFIG_KEY_1=url.https://<PAT>@github.com/.insteadOf
# GIT_CONFIG_VALUE_1=https://github.com/
